<Window x:Class="RevitPlanningPlugin.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RevitPlanningPlugin.UI.Converters"
        xmlns:enums="clr-namespace:RevitPlanningPlugin.Models.Enums"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Генератор планировок — Revit" 
        Width="900" Height="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="700" MinHeight="550"
        Background="#F5F5F5">

    <Window.InputBindings>
        <!-- Горячие клавиши: ← → для навигации по вариантам -->
        <KeyBinding Key="Right" Command="{Binding NextVariantCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PreviousVariantCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <ObjectDataProvider x:Key="ApiEnvironmentValues" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:ApiEnvironment"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Стили -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#757575"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>

        <Style x:Key="NavArrowButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="18" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль для карточки варианта в каталоге -->
        <Style x:Key="VariantCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════ Заголовок и статус-бар ════ -->
        <StackPanel Grid.Row="0">
            <DockPanel>
                <TextBlock Text="Генератор планировок" FontSize="20" FontWeight="Bold" Foreground="#1565C0" DockPanel.Dock="Left"/>
                <TextBlock Text="все операции внутри Revit" FontSize="11" Foreground="#999" VerticalAlignment="Bottom" Margin="8,0,0,2" DockPanel.Dock="Left"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"
                        Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Right" Padding="12,4"/>
            </DockPanel>

            <!-- Статус-бар -->
            <Border Background="{Binding Status, Converter={StaticResource StatusToColor}}" 
                    CornerRadius="4" Padding="8,4" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12"/>
            </Border>

            <!-- Прогресс генерации -->
            <StackPanel Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                <ProgressBar Value="{Binding GenerationProgress}" Maximum="100" Height="6" Foreground="#2196F3" Background="#E0E0E0"/>
                <TextBlock Text="{Binding GenerationElapsed}" Foreground="#888" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ════ Основной контент: вкладки единого рабочего процесса ════ -->
        <TabControl Grid.Row="1" Margin="0,10,0,0">

            <!-- ═══ 1. Подключение ═══ -->
            <TabItem Header="  1. Подключение  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Настройки API"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL:" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Окружение:" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Settings.Environment}" ItemsSource="{Binding Source={StaticResource ApiEnvironmentValues}}" Margin="4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="0,4"/>
                                    <PasswordBox Grid.Row="2" Grid.Column="1" Margin="4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Bearer Token:" VerticalAlignment="Center" Margin="0,4"/>
                                    <PasswordBox Grid.Row="3" Grid.Column="1" Margin="4"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Таймаут (сек):" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.RequestTimeoutSeconds}" Margin="4" Width="80" HorizontalAlignment="Left"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Сохранить" Style="{StaticResource ActionButton}" Command="{Binding SaveSettingsCommand}"/>
                                    <Button Content="Проверить соединение" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 2. Контуры ═══ -->
            <TabItem Header="  2. Контур  ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Загрузить список контуров" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                            Command="{Binding LoadContoursCommand}"/>

                    <ListBox Grid.Row="1" Margin="0,8" ItemsSource="{Binding AvailableContours}" SelectedItem="{Binding SelectedContourSummary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#888" FontSize="11">
                                        <Run Text="{Binding Area, StringFormat='{}{0:F0} м²', Mode=OneWay}"/>
                                        <Run Text=" — "/><Run Text="{Binding Description, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Загрузить и отобразить в Revit" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"
                            Command="{Binding LoadSelectedContourCommand}"/>

                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,8,0,0"
                            Visibility="{Binding HasContour, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ContourInfo}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ContourGeometryInfo}" Foreground="#1565C0" FontSize="12" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding GenerationHistoryInfo}" Foreground="#888" FontSize="11" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ValidationMessages}" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding ValidationResult, Converter={StaticResource NullToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ 3. Генерация ═══ -->
            <TabItem Header="  3. Генерация  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Параметры пакетной генерации"/>
                                <TextBlock Text="Все варианты генерируются за один запрос и доступны сразу для сравнения." Foreground="#888" FontSize="11" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                        <Run Text="Количество вариантов: "/><Run Text="{Binding GenerationParams.VariantCount, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding GenerationParams.VariantCount}"
                                            IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight" Margin="4,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Мин. площадь помещения (м²):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GenerationParams.MinRoomArea}" Margin="4" Width="80" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Макс. площадь помещения (м²):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GenerationParams.MaxRoomArea}" Margin="4" Width="80" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Мин. ширина коридора (м):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GenerationParams.MinCorridorWidth}" Margin="4" Width="80" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Приоритет оптимизации:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="4" Width="160" HorizontalAlignment="Left"
                                              SelectedValue="{Binding GenerationParams.OptimizationPriority}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="efficiency"/>
                                        <ComboBoxItem Content="area"/>
                                        <ComboBoxItem Content="rooms"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="Сгенерировать варианты" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,8"
                                Command="{Binding GenerateCommand}" FontSize="14" Padding="24,10"/>

                        <TextBlock Text="{Binding GenerationHistoryInfo}" Foreground="#888" FontSize="11" Margin="4,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 4. Каталог результатов ═══ -->
            <TabItem Header="  4. Результаты  ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель навигации: ← счётчик → и переключатель истории -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Button Content="◀" Style="{StaticResource NavArrowButton}" Command="{Binding PreviousVariantCommand}" ToolTip="Предыдущий (←)"/>
                            <TextBlock Text="{Binding VariantNavigationInfo}" FontSize="16" FontWeight="Bold" Foreground="#333"
                                       VerticalAlignment="Center" Margin="12,0"/>
                            <Button Content="▶" Style="{StaticResource NavArrowButton}" Command="{Binding NextVariantCommand}" ToolTip="Следующий (→)"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="Показать все из истории" IsChecked="{Binding ShowAllHistory}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="← → для навигации" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Основная область: каталог + детали -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Каталог вариантов (карточки с миниатюрами и метриками) -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="Каталог вариантов"/>
                                <ListBox ItemsSource="{Binding DisplayedVariants}" SelectedItem="{Binding SelectedVariant}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource VariantCard}">
                                                <StackPanel>
                                                    <!-- Заголовок карточки -->
                                                    <DockPanel>
                                                        <TextBlock FontWeight="Bold" FontSize="13" DockPanel.Dock="Left">
                                                            <Run Text="# "/><Run Text="{Binding VariantIndex, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <!-- Score badge -->
                                                        <Border DockPanel.Dock="Right" Background="#1565C0" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                            <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                                <Run Text="{Binding EfficiencyScore, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DockPanel>

                                                    <!-- Каталожная строка метрик -->
                                                    <TextBlock Text="{Binding CatalogSummary, Mode=OneWay}" Foreground="#666" FontSize="11" Margin="0,4,0,0"/>

                                                    <!-- Коэффициент полезной площади — визуальный бар -->
                                                    <Grid Margin="0,4,0,0" Height="6">
                                                        <Border Background="#E8E8E8" CornerRadius="3"/>
                                                        <Border Background="#4CAF50" CornerRadius="3" HorizontalAlignment="Left">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{x:Static converters:RatioToWidthConverter.Instance}">
                                                                    <Binding Path="UsableRatio" Mode="OneWay"/>
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Детали выбранного варианта -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="Детали варианта"/>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding VariantInfo}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>

                                <!-- Кнопки применения -->
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Применить (разделители)" Style="{StaticResource SuccessButton}" Command="{Binding ApplyVariantCommand}"/>
                                    <Button Content="Применить со стенами" Style="{StaticResource ActionButton}" Command="{Binding ApplyWithWallsCommand}"/>
                                </StackPanel>

                                <!-- Таблица помещений -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedVariant.Rooms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="4,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#888" FontSize="11"/>
                                                        <TextBlock Grid.Column="2" Foreground="#444" FontSize="12" HorizontalAlignment="Right">
                                                            <Run Text="{Binding Area, StringFormat='{}{0:F1}', Mode=OneWay}"/><Run Text=" м²"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
